{
  "manifest_version": 3,
  "name": "会话导出增强器",
  "version": "1.3.20",
  "description": "把当前 AI 对话导出为 HTML / Markdown / JSON / 纯文本，支持整段会话或勾选的消息。ChatGPT 走官方接口取原始 Markdown（代码块不会因懒渲染丢失），再由内置 Python 引擎（原版 converter.py）转成与桌面端一致的交互式离线页。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "downloads",
    "scripting",
    "tabs",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "shared/defaults.js",
        "content/dsl.js",
        "content/adapters.js",
        "content/serialize.js",
        "assets/katex.js",
        "content/markdown.js",
        "content/conversation.js",
        "content/widget.js",
        "content/exporters.js",
        "content/worker.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "panel/panel.html",
        "panel/panel.css",
        "panel/panel.js",
        "engine/*",
        "icons/*"
      ],
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "会话导出增强器",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "打开 / 收起导出面板"
    }
  }
}
